#!/bin/sh
# Unified current and historical device inventory for My eQoS Plus.
# Output TSV: mac name ipv4 ipv6 sources interfaces first_seen last_seen online

NAME=myeqosplus
STATE_DIR=/var/run/$NAME
HISTORY_DIR=/etc/$NAME
RAW=$STATE_DIR/devices.raw
CURRENT=$STATE_DIR/devices.current
HISTORY=$HISTORY_DIR/devices.history
LOCK=$STATE_DIR/.lock
NOW=$(date +%s)
WAN_DEVS=

mkdir -p "$STATE_DIR" "$HISTORY_DIR" || exit 1

clean() { printf '%s' "$1" | tr '\t\r\n' '   ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'; }
normalize_mac() { printf '%s' "$1" | tr 'a-f' 'A-F' | sed 's/-/:/g'; }
valid_mac() { printf '%s' "$1" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$'; }
ignored_mac() {
	case "$1" in
		00:00:00:00:00:00|FF:FF:FF:FF:FF:FF|01:00:5E:*|33:33:*|01:80:C2:*) return 0 ;;
	esac
	return 1
}

resolve_wan_dev() {
	local status value expr network
	WAN_DEVS=
	network=$(uci -q get "$NAME.main.wan_network" 2>/dev/null); [ -n "$network" ] || network=wan
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		status=$(ubus call "network.interface.$network" status 2>/dev/null)
		for expr in '@.l3_device' '@.device' '@.pbridge'; do
			value=$(printf '%s' "$status" | jsonfilter -e "$expr" 2>/dev/null)
			[ -n "$value" ] && WAN_DEVS="$WAN_DEVS $value"
		done
	fi
	value=$(uci -q get "network.$network.device" 2>/dev/null); [ -n "$value" ] && WAN_DEVS="$WAN_DEVS $value"
	value=$(uci -q get "network.$network.ifname" 2>/dev/null); [ -n "$value" ] && WAN_DEVS="$WAN_DEVS $value"
	WAN_DEVS="$WAN_DEVS wan wan6 pppoe-wan 6in4-wan"
}

is_wan_iface() {
	local iface=$1 wan
	[ -n "$iface" ] || return 1
	for wan in $WAN_DEVS; do
		[ "$iface" = "$wan" ] && return 0
		[ "${iface%@*}" = "$wan" ] && return 0
	done
	return 1
}

add_raw() {
	local mac ip name source iface online first last
	mac=$(normalize_mac "$1")
	valid_mac "$mac" || return 0
	ignored_mac "$mac" && return 0
	ip=$(clean "$2"); name=$(clean "$3"); source=$(clean "$4"); iface=$(clean "$5")
	online=${6:-1}; first=${7:-}; last=${8:-}
	if [ -z "$first" ] && [ "$online" = 1 ]; then first=$NOW; fi
	if [ -z "$last" ] && [ "$online" = 1 ]; then last=$NOW; fi
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$mac" "$ip" "$name" "$source" "$iface" "$online" "$first" "$last" >> "$RAW"
}

collect_dhcp() {
	[ -r /tmp/dhcp.leases ] || return 0
	while read -r expiry mac ip hostname rest; do
		[ -n "$mac" ] || continue
		local online=1
		case "$expiry" in
			''|*[!0-9]*) online=1 ;;
			*) [ "$expiry" -eq 0 ] || [ "$expiry" -gt "$NOW" ] || online=0 ;;
		esac
		[ "$hostname" = '*' ] && hostname=
		if [ "$online" = 1 ]; then
			add_raw "$mac" "$ip" "$hostname" dhcp '' 1 "$NOW" "$NOW"
		else
			add_raw "$mac" "$ip" "$hostname" dhcp '' 0 '' ''
		fi
	done < /tmp/dhcp.leases
}

collect_neigh() {
	command -v ip >/dev/null 2>&1 || return 0
	local family
	for family in 4 6; do
		ip -$family neigh show 2>/dev/null | awk '
		{
			dev=""; mac=""; state=$NF;
			for (i=1; i<=NF; i++) { if ($i=="dev") dev=$(i+1); if ($i=="lladdr") mac=$(i+1); }
			if (mac != "" && dev != "" && state !~ /^(FAILED|INCOMPLETE|NOARP|NONE)$/) print mac "\t" $1 "\t" dev;
		}' | while IFS="$(printf '\t')" read -r mac addr iface; do
			is_wan_iface "$iface" && continue
			add_raw "$mac" "$addr" '' neigh "$iface" 1 "$NOW" "$NOW"
		done
	done
}

collect_bridge() {
	command -v bridge >/dev/null 2>&1 || return 0
	local bridges br
	bridges=$(ip -o link show type bridge 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1)
	[ -n "$bridges" ] || bridges=br-lan
	for br in $bridges; do
		is_wan_iface "$br" && continue
		bridge fdb show br "$br" 2>/dev/null | awk '$2=="dev" && $1 !~ /^(01:|33:33:|FF:FF:)/ && $0 !~ /(^|[[:space:]])self([[:space:]]|$)/ {print $1 "\t" $3}' | while IFS="$(printf '\t')" read -r mac iface; do
			is_wan_iface "$iface" && continue
			add_raw "$mac" '' '' bridge "$iface" 1 "$NOW" "$NOW"
		done
	done
}

collect_wifi() {
	command -v iw >/dev/null 2>&1 || return 0
	local iface
	iw dev 2>/dev/null | awk '$1=="Interface" {print $2}' | while read -r iface; do
		iw dev "$iface" station dump 2>/dev/null | awk '/^Station / {print $2}' | while read -r mac; do
			add_raw "$mac" '' '' wifi "$iface" 1 "$NOW" "$NOW"
		done
	done
}

import_wifihistory_files() {
	local file mac name ipv4 ipv6 source iface first_seen last_seen online rest
	local configured
	configured=$(uci -q get "$NAME.main.wifihistory_file" 2>/dev/null)
	for file in $configured /var/lib/wifihistory/devices.tsv /var/lib/wifihistory/history.tsv /etc/wifihistory/devices.tsv /etc/wifihistory/history.tsv /tmp/wifihistory/devices.tsv; do
		[ -r "$file" ] || continue
		while IFS="$(printf '\t')" read -r mac name ipv4 ipv6 source iface first_seen last_seen online rest; do
			case "$mac" in mac|MAC|'#'*) continue ;; esac
			mac=$(normalize_mac "$mac"); valid_mac "$mac" || continue
			[ "$online" = 1 ] || online=0
			[ -n "$source" ] || source=wifihistory
			[ -n "$ipv4" ] && add_raw "$mac" "$ipv4" "$name" "$source" "$iface" "$online" "$first_seen" "$last_seen"
			[ -n "$ipv6" ] && add_raw "$mac" "$ipv6" "$name" "$source" "$iface" "$online" "$first_seen" "$last_seen"
			[ -n "$ipv4$ipv6" ] || add_raw "$mac" '' "$name" "$source" "$iface" "$online" "$first_seen" "$last_seen"
		done < "$file"
	done
}

import_wifihistory_uci() {
	command -v uci >/dev/null 2>&1 || return 0
	local section mac name ipv4 ipv6 ip online first last iface
	uci -q show wifihistory 2>/dev/null | sed -n 's/^wifihistory\.\([^.=]*\)\.mac=.*/\1/p' | sort -u | while read -r section; do
		mac=$(uci -q get "wifihistory.$section.mac" 2>/dev/null)
		name=$(uci -q get "wifihistory.$section.hostname" 2>/dev/null)
		[ -n "$name" ] || name=$(uci -q get "wifihistory.$section.name" 2>/dev/null)
		ipv4=$(uci -q get "wifihistory.$section.ipv4" 2>/dev/null)
		[ -n "$ipv4" ] || ipv4=$(uci -q get "wifihistory.$section.ip" 2>/dev/null)
		ipv6=$(uci -q get "wifihistory.$section.ipv6" 2>/dev/null)
		iface=$(uci -q get "wifihistory.$section.interface" 2>/dev/null)
		online=$(uci -q get "wifihistory.$section.online" 2>/dev/null); [ "$online" = 1 ] || online=0
		first=$(uci -q get "wifihistory.$section.first_seen" 2>/dev/null)
		last=$(uci -q get "wifihistory.$section.last_seen" 2>/dev/null)
		[ -n "$ipv4" ] && add_raw "$mac" "$ipv4" "$name" wifihistory "$iface" "$online" "$first" "$last"
		[ -n "$ipv6" ] && add_raw "$mac" "$ipv6" "$name" wifihistory "$iface" "$online" "$first" "$last"
		[ -n "$ipv4$ipv6" ] || add_raw "$mac" '' "$name" wifihistory "$iface" "$online" "$first" "$last"
	done
}

aggregate_current() {
	awk -F '\t' -v OFS='\t' '
	function uniq(old, value,   n,a,i) {
		if (value=="") return old; if (old=="") return value;
		n=split(old,a,","); for(i=1;i<=n;i++) if(a[i]==value) return old;
		return old "," value;
	}
	function minv(a,b) { if (a=="") return b; if (b=="") return a; return (a < b ? a : b); }
	function maxv(a,b) { if (a=="") return b; if (b=="") return a; return (a > b ? a : b); }
	{
		m=$1; ip=$2; nm=$3; src=$4; iface=$5; on=$6; fs=$7; ls=$8;
		if (!(m in seen)) { seen[m]=1; order[++count]=m; }
		if (ip ~ /:/) ip6[m]=uniq(ip6[m],ip); else if (ip!="") ip4[m]=uniq(ip4[m],ip);
		if (nm!="" && name[m]=="") name[m]=nm;
		sources[m]=uniq(sources[m],src); interfaces[m]=uniq(interfaces[m],iface);
		first[m]=minv(first[m],fs); last[m]=maxv(last[m],ls);
		if (on=="1") online[m]=1;
	}
	END { for(i=1;i<=count;i++) { m=order[i]; print m,name[m],ip4[m],ip6[m],sources[m],interfaces[m],first[m],last[m],(online[m]?1:0); } }' "$RAW" > "$CURRENT.new" && mv "$CURRENT.new" "$CURRENT"
}

merge_history() {
	if [ ! -s "$CURRENT" ]; then
		awk -F '\t' -v OFS='\t' 'NF >= 9 { print $1,$2,$3,$4,$5,$6,$7,$8,0 }' "$HISTORY" > "$HISTORY.new" 2>/dev/null || :
	else
		awk -F '\t' -v OFS='\t' -v now="$NOW" '
		function uniq(old, value,   n,a,i) {
			if (value=="") return old; if (old=="") return value;
			n=split(old,a,","); for(i=1;i<=n;i++) if(a[i]==value) return old;
			return old "," value;
		}
		function parse(line,a,   i,n) { for(i=1;i<=9;i++) a[i]=""; if(line!="") n=split(line,a,FS); return n; }
		function minv(a,b) { if (a=="") return b; if (b=="") return a; return (a < b ? a : b); }
		FNR==NR { if ($1!="") { c[$1]=$0; corder[++cn]=$1; } next }
		{ if ($1!="") { h[$1]=$0; horder[++hn]=$1; } }
		END {
			for(i=1;i<=cn;i++) {
				m=corder[i]; parse(c[m],a); parse(h[m],b);
				first=minv(a[7],b[7]); if(first=="") first=now;
				last=(a[9]=="1" ? (a[8]!="" ? a[8] : now) : b[8]);
				print m,(a[2]!=""?a[2]:b[2]),uniq(b[3],a[3]),uniq(b[4],a[4]),uniq(b[5],a[5]),uniq(b[6],a[6]),first,last,(a[9]=="1"?1:0); used[m]=1;
			}
			for(i=1;i<=hn;i++) { m=horder[i]; if(used[m]) continue; parse(h[m],b); print b[1],b[2],b[3],b[4],b[5],b[6],b[7],b[8],0; }
		}' "$CURRENT" "$HISTORY" > "$HISTORY.new" 2>/dev/null || cp "$CURRENT" "$HISTORY.new"
	fi
	mv "$HISTORY.new" "$HISTORY"
}

prune_history() {
	local days cutoff
	days=$(uci -q get "$NAME.main.history_retention_days" 2>/dev/null)
	case "$days" in ''|*[!0-9]*) return 0 ;; esac
	[ "$days" -gt 0 ] || return 0
	cutoff=$((NOW - days * 86400))
	awk -F '\t' -v cutoff="$cutoff" 'NF >= 9 && ($8 == "" || $8 >= cutoff)' "$HISTORY" > "$HISTORY.new" 2>/dev/null && mv "$HISTORY.new" "$HISTORY"
}

release_lock() { rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true; }
refresh() {
	if [ -d "$LOCK" ]; then
		local pid
		pid=$(cat "$LOCK/pid" 2>/dev/null)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
		rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || return 1
	fi
	mkdir "$LOCK" 2>/dev/null || return 0
	echo $$ > "$LOCK/pid"
	trap 'release_lock; rm -f "$RAW" "$HISTORY.new"' EXIT INT TERM
	: > "$RAW" || return 1
	[ -f "$HISTORY" ] || : > "$HISTORY"
	resolve_wan_dev
	collect_dhcp
	collect_neigh
	collect_bridge
	collect_wifi
	import_wifihistory_files
	import_wifihistory_uci
	aggregate_current
	merge_history
	prune_history
}

case "${1:-list}" in
	refresh) refresh ;;
	list) refresh && cat "$HISTORY" 2>/dev/null ;;
	status) refresh && awk -F '\t' 'BEGIN{online=0;total=0} NF>=9 {total++;if($9==1)online++} END{printf "total=%d\tonline=%d\toffline=%d\n",total,online,total-online}' "$HISTORY" ;;
	*) echo "usage: $0 {refresh|list|status}" >&2; exit 2 ;;
esac


