config myeqosplus 'main'
	option enabled '0'
	option schema_version '3'
	option ifname 'auto'
	option wan_network 'wan'
	option lan_network 'lan'
	option multiqueue_policy 'refuse'
	option multiqueue_mode 'preserve'
	option preserve_existing_qdisc '1'
	option manage_flow_offloading '1'
	option upload_ceiling_kbit '1000000'
	option download_ceiling_kbit '1000000'
	option history_retention_days '90'
	option refresh_interval '30'

# Device policies are bound to a MAC and remain while the device is offline.
# download_kbit shapes WAN ingress through IFB; upload_kbit shapes WAN egress.
# Optional schedule: option week '1,2,3,4,5' and
# option time_ranges '09:00-10:00,12:00-14:00'; empty means all day.

# Optional import path written by wifihistory-compatible deployments.
# option wifihistory_file '/var/lib/wifihistory/devices.tsv'
