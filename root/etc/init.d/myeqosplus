#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

NAME=myeqosplus

start_service() {
	mkdir -p /var/run/$NAME /etc/$NAME
	/usr/sbin/myeqosplus-devices refresh >/dev/null 2>&1 || true
	# A disabled service must actively clean up stale qdisc/IFB/nft state and
	# restore a flow-offloading snapshot left by an interrupted start.
	if [ "$(uci -q get $NAME.main.enabled 2>/dev/null)" != 1 ]; then
		/usr/bin/myeqosplus stop >/var/log/$NAME.log 2>&1 || true
		return 0
	fi
	if ! /usr/bin/myeqosplus start >/var/log/$NAME.log 2>&1; then
		return 1
	fi
	procd_open_instance
	procd_set_param command /usr/bin/myeqosplusctrl
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/bin/myeqosplus stop >/var/log/$NAME.log 2>&1 || true
}

reload_service() {
	stop_service
	start_service
}

service_triggers() {
	procd_add_reload_trigger myeqosplus
}
